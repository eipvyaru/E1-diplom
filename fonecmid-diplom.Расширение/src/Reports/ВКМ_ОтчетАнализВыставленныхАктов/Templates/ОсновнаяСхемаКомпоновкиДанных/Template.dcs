<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Договор</dataPath>
			<field>Договор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаКВыставлению</dataPath>
			<field>СуммаКВыставлению</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма к выставлению клиенту</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаВыставленнаяПоАктам</dataPath>
			<field>СуммаВыставленнаяПоАктам</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Фактическая сумма, выставленная по актам</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВКМ_Организация</dataPath>
			<field>ВКМ_Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВКМ_Клиент</dataPath>
			<field>ВКМ_Клиент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВКМ_Договор</dataPath>
			<field>ВКМ_Договор</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_НоменклатураРаботыСпециалиста.Значение КАК Номенклатура
ПОМЕСТИТЬ ТЗ_НоменклатураРаботыСпециалиста
ИЗ
	Константа.ВКМ_НоменклатураРаботыСпециалиста КАК ВКМ_НоменклатураРаботыСпециалиста
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВКМ_НоменклатураАбонентскаяПлата.Значение КАК Номенклатура
ПОМЕСТИТЬ ТЗ_НоменклатураАбонентскаяПлата
ИЗ
	Константа.ВКМ_НоменклатураАбонентскаяПлата КАК ВКМ_НоменклатураАбонентскаяПлата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВКМ_АктыРеализацииУслугОбороты.Контрагент КАК Контрагент,
	ВКМ_АктыРеализацииУслугОбороты.Номенклатура КАК Номенклатура,
	ВКМ_АктыРеализацииУслугОбороты.Договор КАК Договор,
	ВКМ_АктыРеализацииУслугОбороты.СуммаОборот КАК СуммаОборот
ПОМЕСТИТЬ ВТАкт
ИЗ
	РегистрНакопления.ВКМ_АктыРеализацииУслуг.Обороты(&amp;НачалоПериода, &amp;КонецПериода,,) КАК ВКМ_АктыРеализацииУслугОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДоговорыКонтрагентов.Владелец КАК Контрагент,
	ДоговорыКонтрагентов.Ссылка КАК Договор,
	ТЗ_НоменклатураАбонентскаяПлата.Номенклатура КАК Номенклатура,
	ДоговорыКонтрагентов.ВКМ_СуммаЕжемесячнойАбонентскойПлаты КАК МесАбонентскаяОплата
ПОМЕСТИТЬ ВТДог
ИЗ
	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов,
	ТЗ_НоменклатураАбонентскаяПлата КАК ТЗ_НоменклатураАбонентскаяПлата
ГДЕ
	ДоговорыКонтрагентов.ВКМ_ДатаНачалаДоговораОбслуживания &lt;= &amp;КонецПериода
	И ДоговорыКонтрагентов.ВКМ_ДатаОкончанияДоговораОбслуживания &gt;= &amp;НачалоПериода
	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВКМ_ВыполненныеКлиентуРаботыОбороты.ВКМ_Клиент КАК ВКМ_Клиент,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.ВКМ_Договор КАК ВКМ_Договор,
	ТЗ_НоменклатураРаботыСпециалиста.Номенклатура КАК Номенклатура,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.ВКМ_СуммаКОплатеПриход КАК ВКМ_СуммаКОплатеПриход
ПОМЕСТИТЬ ВТОбслуж
ИЗ
	РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.Обороты(&amp;НачалоПериода, &amp;КонецПериода,,) КАК
		ВКМ_ВыполненныеКлиентуРаботыОбороты,
	ТЗ_НоменклатураРаботыСпециалиста КАК ТЗ_НоменклатураРаботыСпециалиста
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТДог.Контрагент КАК Контрагент,
	ВТДог.Договор КАК Договор,
	ВТДог.Номенклатура КАК Номенклатура,
	ВТДог.МесАбонентскаяОплата КАК СуммаВыполнено
ПОМЕСТИТЬ ВТВыполнено
ИЗ
	ВТДог КАК ВТДог

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВТОбслуж.ВКМ_Клиент,
	ВТОбслуж.ВКМ_Договор,
	ВТОбслуж.Номенклатура,
	ВТОбслуж.ВКМ_СуммаКОплатеПриход
ИЗ
	ВТОбслуж КАК ВТОбслуж
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ВТАкт.Контрагент, ВТВыполнено.Контрагент) КАК Контрагент,
	ЕСТЬNULL(ВТАкт.Договор, ВТВыполнено.Договор) КАК Договор,
	ЕСТЬNULL(ВТАкт.Номенклатура, ВТВыполнено.Номенклатура) КАК Номенклатура,
	ВТВыполнено.СуммаВыполнено КАК СуммаКВыставлению,
	ВТАкт.СуммаОборот КАК СуммаВыставленнаяПоАктам
ИЗ
	ВТВыполнено КАК ВТВыполнено
		ПОЛНОЕ СОЕДИНЕНИЕ ВТАкт КАК ВТАкт
		ПО ВТВыполнено.Контрагент = ВТАкт.Контрагент
		И ВТВыполнено.Договор = ВТАкт.Договор
		И ВТВыполнено.Номенклатура = ВТАкт.Номенклатура</query>
	</dataSet>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>НачалоПериода(&amp;Период.ДатаНачала, "Месяц")</expression>
		<inputParameters>
			<dcscor:item>
				<dcscor:parameter>ФорматРедактирования</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ДФ=MM.yyyy</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</inputParameters>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>КонецПериода(&amp;Период.ДатаОкончания,"Месяц")</expression>
		<inputParameters>
			<dcscor:item>
				<dcscor:parameter>ФорматРедактирования</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ДФ=MM.yyyy</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</inputParameters>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<inputParameters>
			<dcscor:item>
				<dcscor:parameter>ФорматРедактирования</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ДФ=MM.yyyy</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</inputParameters>
	</parameter>
